# Copy this file to .env and fill in your values
# Never commit .env to git

# Wallet private key (deployer and/or keeper)
PRIVATE_KEY=0x...

# RPC endpoint
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Contract addresses (filled in after deploy)
AGENT_ADDRESS=
REGISTRY_ADDRESS=

# Keeper address (the wallet that calls executeRule)
KEEPER_ADDRESS=

# Arbiscan API key for contract verification
ARBISCAN_API_KEY=

# Keeper polling interval in milliseconds (default 60s)
POLL_INTERVAL_MS=60000

# Optional: Robinhood Chain RPC
# ROBINHOOD_RPC_URL=
